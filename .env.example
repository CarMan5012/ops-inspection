# 系统名称（默认值：自动巡检报告系统）
APP_NAME=自动巡检报告系统

# 运行日志级别，可选: DEBUG, INFO, WARNING, ERROR（默认值：INFO）
LOG_LEVEL=INFO

# 应用内调度时区（默认值：Asia/Shanghai）
APP_TIMEZONE=Asia/Shanghai

# Linux 容器系统级时区（默认值：Asia/Shanghai）
TZ=Asia/Shanghai

# 默认管理员用户名（默认值：admin）
ADMIN_USERNAME=admin

# 默认管理员密码（默认值：admin）
ADMIN_PASSWORD=please-change-this-password

# 应用数据解密主密钥，本地调试可临时设置（默认值：空）
# APP_SECRET_KEY=please-change-this-secret

# Docker Secret 主密钥挂载路径，容器部署推荐使用（默认值：/run/secrets/app_secret_key）
APP_SECRET_KEY_FILE=/run/secrets/app_secret_key



# 应用持久化数据目录（默认值：data）
APP_DATA_DIR=./data

# 前端页面路由前缀（默认值：/ops）
FRONTEND_BASE_PATH=/ops

# API 接口路由后缀。系统会自动将其拼在 FRONTEND_BASE_PATH 后面，最终 API 地址为 /ops/api。注意：请勿在此处填写 /ops/api，否则会导致重复拼接（默认值：/api）
API_PREFIX=/api

# 前端最近运行历史最大展示条数（默认值：50）
APP_MAX_RECENT_RUNS=50


# ------------------------------------------------------------------------------
# 4. 图表与无头截图渲染
# ------------------------------------------------------------------------------

# 关联的 Grafana 访问地址（默认值：http://localhost:3000）
GRAFANA_URL=http://localhost:3000

# Grafana 容器镜像版本（默认值：grafana/grafana-oss:11.4.0）
GRAFANA_IMAGE=grafana/grafana-oss:11.4.0

# 关联的 Grafana 默认管理员用户名（默认值：admin）
GRAFANA_USER=admin

# 关联的 Grafana 默认管理员密码（默认值：admin）
GRAFANA_PASS=admin

# 容器内 Playwright 无头截图所使用的虚拟屏幕代号（默认值：:99）
DISPLAY=:99
