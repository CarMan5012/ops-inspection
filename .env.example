# ==============================================================================
# 1. 基础应用配置 (Core Application Config)
# ==============================================================================

# 系统名称（显示在浏览器标签或后台界面上）
APP_NAME=自动巡检报告系统

# 运行日志级别，可选: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 应用内自动调度的时区（如定时巡检任务使用的时区）
APP_TIMEZONE=Asia/Shanghai

# Linux 容器系统级时区
TZ=Asia/Shanghai

# 默认管理员登录用户名
ADMIN_USERNAME=admin

# 默认管理员登录密码（建议首次登录后立即更改）
ADMIN_PASSWORD=please-change-this-password

# ------------------------------------------------------------------------------
# 2. 数据库与解密安全配置 (Database & Secrets Config)
# ------------------------------------------------------------------------------

# SQLCipher 数据库文件物理加密密钥。若不填，默认采用系统主密钥（APP_SECRET_KEY）
SQLCIPHER_DB_KEY=please-change-this-db-key

# 应用数据解密主密钥。用于加密保存数据库中的邮箱密码、MFA 密钥、机器人密钥等。
# 【注意】建议生产环境不要直接写在 env 中，而使用下方挂载文件的安全方式。
# APP_SECRET_KEY=please-change-this-secret

# Docker Secret 主密钥挂载路径，容器部署推荐使用本方式读取密钥
APP_SECRET_KEY_FILE=/run/secrets/app_secret_key

# 应用持久化数据存储目录（存放数据库、运行生成的截图、日志、报告等）
APP_DATA_DIR=./data

# ------------------------------------------------------------------------------
# 3. 路由与展示历史 (Routing & UI Config)
# ------------------------------------------------------------------------------

# 前端页面访问根路径（例如 http://localhost:8000/ops）
FRONTEND_BASE_PATH=/ops

# API 接口路由后缀。系统会自动拼接在 FRONTEND_BASE_PATH 后面，最终 API 地址为 /ops/api
API_PREFIX=/api

# 前端“最近运行”历史记录最大展示条数
APP_MAX_RECENT_RUNS=50

# ------------------------------------------------------------------------------
# 4. 图表与无头截图渲染 (Grafana & Screenshots Config)
# ------------------------------------------------------------------------------

# 关联的 Grafana 访问地址
GRAFANA_URL=http://localhost:3000

# Grafana 容器镜像版本（docker-compose 启动时使用）
GRAFANA_IMAGE=grafana/grafana-oss:11.4.0

# 关联的 Grafana 默认管理员用户名
GRAFANA_USER=admin

# 关联的 Grafana 默认管理员密码
GRAFANA_PASS=admin

# 容器内 Playwright 无头截图所使用的虚拟屏幕 Xvfb 端口代号
DISPLAY=:99

# 虚拟屏幕的分辨率与颜色深度（真实浏览器截图时建议与截图分辨率匹配）
XVFB_WIDTH=3840
XVFB_HEIGHT=2160
XVFB_DEPTH=24

# 【可选】自定义 Windows 任务栏模拟底栏图片模板的路径（若不填，默认使用程序内置的图片模板）
# TASKBAR_TEMPLATE_PATH=

# 【可选】自定义任务栏上时钟字体的路径（Windows 系统推荐使用 C:\Windows\Fonts\msyh.ttc）
# TASKBAR_CLOCK_FONT_PATH=

# ------------------------------------------------------------------------------
# 5. 全局钉钉推送配置 (DingTalk Notify Config - 可选)
# ------------------------------------------------------------------------------

# 全局钉钉机器人 Webhook 地址
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=...

# 全局钉钉机器人加签密钥 (Secret)
# DINGTALK_SECRET=SEC...

# 全局钉钉机器人安全关键词
# DINGTALK_KEYWORD=巡检
